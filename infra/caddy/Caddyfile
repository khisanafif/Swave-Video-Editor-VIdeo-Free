# SWAVE Video (Self-Hosted & Web-Native Visual Editor) — Caddy Alternative Config
# Provides automatic local HTTPS (tls internal) for LAN/WiFi access
# enabling WebCodecs, OPFS, and SharedArrayBuffer on connected devices.

:8080 {
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
	}

	request_body {
		max_size 50MB
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle_path /media/* {
		root * /mnt/storage/swave_media
		header Cross-Origin-Resource-Policy "same-origin"
		file_server
	}

	handle {
		root * /var/www/swave-video/dist
		try_files {path} /index.html
		file_server
	}
}
