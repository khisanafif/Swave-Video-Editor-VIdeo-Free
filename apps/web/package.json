{
  "name": "@velocut/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "android:init": "npx --yes @capacitor/cli@latest add android",
    "android:sync": "npm run build && npx --yes @capacitor/cli@latest sync android",
    "android:open": "npx --yes @capacitor/cli@latest open android"
  },
  "dependencies": {
    "@velocut/shared": "*",
    "immer": "^10.1.1",
    "lucide-react": "^0.475.0",
    "mp4-muxer": "^5.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

